/* Private build-time defaults for esp32-weather-epd.
 *
 * Copy secrets.h.example to secrets.h and fill in your values.
 * secrets.h is git-ignored; never commit it.
 *
 * WiFi credentials here are only fallbacks for development. Devices
 * normally get WiFi credentials (and may override the API key) through
 * the setup portal, which stores them in non-volatile storage.
 */

#ifndef __SECRETS_H__
#define __SECRETS_H__

// WiFi network name (SSID) and password. Leave empty to rely on the setup
// portal.
#define SECRET_WIFI_SSID     ""
#define SECRET_WIFI_PASSWORD ""

// OpenWeatherMap API key, https://openweathermap.org/
#define SECRET_OWM_APIKEY    ""

#endif
